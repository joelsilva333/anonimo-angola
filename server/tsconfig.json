{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*"]
    },
    // "baseUrl": "./"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist"]
}
